---
interface Props {
  lang?: string;
  privacyHref?: string;
}

const { lang = 'fr', privacyHref = '/privacy-policy/' } = Astro.props;
const normalizedLang = lang.toLowerCase().split('-')[0];

const copy = {
  fr: {
    text: 'Nous utilisons quelques cookies pour mesurer l’audience et améliorer les liens vers nos offres. Vous pouvez continuer votre lecture en les acceptant ou en les refusant.',
    accept: 'OK, j’accepte',
    refuse: 'Continuer sans accepter',
    link: 'Politique de confidentialité',
    aria: 'Information sur les cookies',
  },
  en: {
    text: 'We use a few cookies to measure audience activity and improve links to our offers. You can continue reading by accepting or refusing them.',
    accept: 'OK, I accept',
    refuse: 'Continue without accepting',
    link: 'Privacy Policy',
    aria: 'Cookie notice',
  },
  de: {
    text: 'Wir verwenden einige Cookies, um die Nutzung der Seite zu messen und Links zu unseren Angeboten zu verbessern. Du kannst sie akzeptieren oder ablehnen.',
    accept: 'OK, akzeptieren',
    refuse: 'Ohne Akzeptieren fortfahren',
    link: 'Datenschutzerklärung',
    aria: 'Cookie-Hinweis',
  },
  nl: {
    text: 'We gebruiken enkele cookies om het gebruik van de site te meten en links naar onze aanbiedingen te verbeteren. Je kunt ze accepteren of weigeren.',
    accept: 'OK, accepteren',
    refuse: 'Doorgaan zonder te accepteren',
    link: 'Privacybeleid',
    aria: 'Cookiemelding',
  },
  es: {
    text: 'Usamos algunas cookies para medir la audiencia y mejorar los enlaces hacia nuestras ofertas. Puedes aceptarlas o rechazarlas.',
    accept: 'OK, acepto',
    refuse: 'Continuar sin aceptar',
    link: 'Política de privacidad',
    aria: 'Aviso de cookies',
  },
  it: {
    text: 'Utilizziamo alcuni cookie per misurare l’audience e migliorare i link verso le nostre offerte. Puoi accettarli o rifiutarli.',
    accept: 'OK, accetto',
    refuse: 'Continua senza accettare',
    link: 'Informativa sulla privacy',
    aria: 'Avviso sui cookie',
  },
} as const;

const notice = copy[normalizedLang as keyof typeof copy] ?? copy.fr;
---

<section
  id="cookie-notice"
  class="cookie-notice"
  role="region"
  aria-label={notice.aria}
  hidden
>
  <p class="cookie-notice__text">{notice.text}</p>
  <div class="cookie-notice__buttons">
    <button class="cookie-notice__refuse" type="button" id="cookie-notice-refuse">
      {notice.refuse}
    </button>
    <button class="cookie-notice__button" type="button" id="cookie-notice-accept">
      {notice.accept}
    </button>
  </div>
  <a class="cookie-notice__link" href={privacyHref}>{notice.link}</a>
</section>

<script>
  (() => {
    const storageKey = 'lmc_cookie_notice_v1';
    const notice = document.getElementById('cookie-notice');
    const accept = document.getElementById('cookie-notice-accept');
    const refuse = document.getElementById('cookie-notice-refuse');

    if (!notice || !accept || !refuse) return;

    const updateConsent = (granted: boolean) => {
      const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
      if (typeof w.gtag === 'function') {
        w.gtag('consent', 'update', { analytics_storage: granted ? 'granted' : 'denied' });
      }
    };

    const close = (value: string) => {
      try {
        window.localStorage.setItem(storageKey, value);
      } catch (_) {
        // Ignore private-mode storage errors; the notice still closes cleanly.
      }
      updateConsent(value === 'accepted');
      notice.setAttribute('hidden', '');
    };

    let stored: string | null = null;
    try {
      stored = window.localStorage.getItem(storageKey);
    } catch (_) {
      // If localStorage is unavailable, show the notice for this page view only.
    }

    if (stored) {
      updateConsent(stored === 'accepted');
      return;
    }

    notice.hidden = false;
    accept.addEventListener('click', () => close('accepted'));
    refuse.addEventListener('click', () => close('refused'));
  })();
</script>

<style>
  .cookie-notice {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    width: min(390px, calc(100vw - 2rem));
    padding: 1rem;
    background: #f4f2ec;
    color: #242424;
    border: 1px solid rgba(36, 36, 36, 0.1);
    border-radius: 0.875rem;
    box-shadow: 0 12px 32px rgba(36, 36, 36, 0.14);
    font-family: 'PT Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .cookie-notice[hidden] {
    display: none;
  }

  .cookie-notice__text {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .cookie-notice__link {
    display: inline-block;
    margin-top: 0.6rem;
    color: #5f5045;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cookie-notice__buttons {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }

  .cookie-notice__refuse {
    flex: 1 1 0;
    border: 1px solid rgba(36, 36, 36, 0.25);
    border-radius: 0.5rem;
    background: transparent;
    color: #5f5045;
    cursor: pointer;
    font-family: 'Archivo', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0.6rem 0.5rem;
    text-align: center;
  }

  .cookie-notice__refuse:hover {
    background: rgba(36, 36, 36, 0.05);
  }

  .cookie-notice__button {
    flex: 1 1 0;
    border: 0;
    border-radius: 0.5rem;
    background: #ef7a1a;
    color: #fff;
    cursor: pointer;
    font-family: 'Archivo', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.2;
    padding: 0.6rem 0.5rem;
    text-align: center;
    box-shadow: 0 1px 3px rgba(36, 24, 12, 0.12);
  }

  .cookie-notice__button:hover {
    background: #d96b13;
  }

  .cookie-notice__button:focus-visible,
  .cookie-notice__link:focus-visible {
    outline: 3px solid rgba(239, 122, 26, 0.35);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .cookie-notice {
      left: max(0.75rem, env(safe-area-inset-left));
      right: max(0.75rem, env(safe-area-inset-right));
      bottom: calc(4.75rem + env(safe-area-inset-bottom));
      width: auto;
      padding: 0.875rem;
      border-radius: 0.75rem;
    }

    .cookie-notice__text {
      font-size: 0.8125rem;
      margin-bottom: 0.65rem;
    }

  }
</style>
